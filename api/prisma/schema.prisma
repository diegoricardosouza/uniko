generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  email                String    @unique
  password             String
  role                 String
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  @@map("users")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  subtitle  String?
  slug      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação many-to-many com CategoryPost
  categories PostCategory[]

  @@map("posts")
}

model CategoryPost {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relação many-to-many com Post
  posts PostCategory[]

  @@map("category_posts")
}

// Tabela de junção para a relação many-to-many
model PostCategory {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relacionamentos
  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category CategoryPost @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Índice único para evitar duplicatas
  @@unique([postId, categoryId])
  @@map("post_categories")
}

// Tabela centralizada de mídias
model Media {
  id           String  @id @default(uuid()) @db.Uuid
  filename     String // Nome do arquivo
  originalName String  @map("original_name") // Nome original do arquivo
  mimeType     String  @map("mime_type") // image/jpeg, video/mp4, etc
  size         Int // Tamanho em bytes
  url          String
  thumbnailUrl String? @map("thumbnail_url") // URL da thumbnail (para vídeos/imagens)
  alt          String?
  title        String?
  description  String?

  // Campos para relacionamento polimórfico
  entityType String  @map("entity_type") // 'Post', 'Property', 'User', etc
  entityId   String? @map("entity_id") @db.Uuid // ID da entidade relacionada
  mediaType  String  @map("media_type") // 'featured_image', 'gallery', 'attachment', etc

  // Campos para ordenação e controle
  order    Int     @default(0) // Ordem das mídias na galeria
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices para performance
  @@index([entityType, entityId])
  @@index([entityType, entityId, order])
  @@map("medias")
}

model Setting {
  id             String   @id @default(uuid()) @db.Uuid
  titleSeo       String?  @map("title_seo")
  descriptionSeo String?  @map("description_seo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unitCompany UnitCompanySetting[]
  socialMedia SocialMediaSetting[]

  @@map("settings")
}

model UnitCompanySetting {
  id        String   @id @default(uuid()) @db.Uuid
  settingId String?  @map("setting_id") @db.Uuid
  name      String?
  email     String?
  telephone String?
  cellphone String?
  service   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setting Setting? @relation(fields: [settingId], references: [id])

  @@map("unit_companies")
}

model SocialMediaSetting {
  id        String   @id @default(uuid()) @db.Uuid
  settingId String?  @map("setting_id") @db.Uuid
  name      String?
  url       String?
  icon      String?
  iconJson  Json?    @map("icon_json")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setting Setting? @relation(fields: [settingId], references: [id])

  @@map("social_medias")
}

model Page {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  slug    String  @unique
  content String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

model Email {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  to           String
  subject      String
  htmlContent  String            @map("html_content")
  status       EmailStatus       @default(PENDING)
  sentAt       DateTime?         @map("sent_at")
  errorMessage String?           @map("error_message")
  attachments  EmailAttachment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("emails")
}

model EmailAttachment {
  id       String @id @default(uuid()) @db.Uuid
  emailId  String @map("email_id") @db.Uuid
  filename String
  path     String
  mimetype String
  size     Int

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@map("email_attachments")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model State {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  slug    String @unique
  acronym String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]

  @@map("states")
}

model City {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  slug    String @unique
  stateId String @map("state_id") @db.Uuid

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  neighborhoods Neighborhood[]

  @@map("cities")
}

model Neighborhood {
  id     String @id @default(uuid()) @db.Uuid
  name   String
  slug   String @unique
  cityId String @map("city_id") @db.Uuid

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("neighborhoods")
}

model CategoryType {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("types")
}

model CategoryFinality {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finalities")
}
